# Optional overrides for running the backend in a bare virtualenv (copy to backend/.env).
# Docker Compose sets its own environment and ignores this file.

# Without Docker you can use SQLite; Docker/CI/production use PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos

DJANGO_DEBUG=true
# REDIS_URL=redis://localhost:6379/0

# --- AI assistant (optional, SDD §9) ---------------------------------------------
# Off by default; nothing else depends on it. With a key, Claude (claude-opus-5-5) answers.
# AI_PROVIDER=fake gives a scripted demo assistant that never calls the network.
AI_ENABLED=false
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MONTHLY_TOKEN_LIMIT=2000000
# Without a Celery worker (bare-metal dev), answer inside the request:
AI_RUN_INLINE=false
