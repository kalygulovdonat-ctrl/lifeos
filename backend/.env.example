# Optional overrides for running the backend in a bare virtualenv (copy to backend/.env).
# Docker Compose sets its own environment and ignores this file.

# Without Docker you can use SQLite; Docker/CI/production use PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos

DJANGO_DEBUG=true
# REDIS_URL=redis://localhost:6379/0
