# syntax=docker/dockerfile:1
# Single-container image for Render's free plan: Django serves the API and the React build.
# AI runs inline (no Celery worker); scheduled reminders (beat) are not available on this plan.
FROM node:22-alpine AS frontend
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production \
    FRONTEND_DIST=/app/frontend
WORKDIR /app
COPY backend/requirements/ requirements/
RUN pip install -r requirements/base.txt
COPY backend/ .
COPY --from=frontend /app/dist /app/frontend
RUN useradd --system --uid 1001 lifeos \
    && mkdir -p /app/media /app/staticfiles \
    && chown -R lifeos /app
USER lifeos
RUN DJANGO_SECRET_KEY=build-only DJANGO_ALLOWED_HOSTS=localhost python manage.py collectstatic --noinput
EXPOSE 10000
# The free plan has no pre-deploy step, so migrations run on start.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn config.asgi:application -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT:-10000} -w 2 --access-logfile -"]
