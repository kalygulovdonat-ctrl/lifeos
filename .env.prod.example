# Copy to .env.prod on the server and fill in real values. Never commit .env.prod.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_SIGNING_KEY=change-me-to-another-long-random-string
DJANGO_ALLOWED_HOSTS=lifeos.example.com
DJANGO_ADMIN_URL=change-me-admin-path/
CSRF_TRUSTED_ORIGINS=https://lifeos.example.com
REGISTRATION_OPEN=false

# Database (the db service reads POSTGRES_*; Django reads DATABASE_URL)
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://lifeos:change-me@db:5432/lifeos

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LifeOS <noreply@lifeos.example.com>

# Logging
LOG_LEVEL=INFO
